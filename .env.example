# 复制为 .env 后修改；SETUP_TOKEN 请使用 secrets 命令生成，不要沿用示例值。
SETUP_TOKEN=
COOKIE_SECURE=0
NEWSROOM_DATA_DIR=/data
TZ=Asia/Shanghai
NEWSROOM_BIND=127.0.0.1
NEWSROOM_DOMAIN=reader.example.com
# auto：有显式代理时优先代理，临时失败后尝试直连；direct：只直连；proxy：只走显式代理。
NEWSROOM_FETCH_MODE=auto
NEWSROOM_OUTBOUND_PROXY=
# fallback：系统解析失败或返回非公网地址时尝试 DNSPod 加密 DNS；system：只用系统 DNS；https：只用加密 DNS。
NEWSROOM_DNS_MODE=fallback
